{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "write": "allow",
    "edit": "allow",
    "external_directory": {
      "*": "ask"
    },
    "bash": {
      "*": "allow",
      "curl * | sh": "ask",
      "curl * | bash": "ask",
      "find * -exec *": "ask",
      "find * | xargs *": "ask",
      "find * -delete": "ask",
      "git reset --hard *": "ask",
      "git branch -D *": "ask",
      "git push *": "ask",
      "git clean *": "ask",
      "git checkout *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git pull *": "ask",
      "git commit *": "ask",
      "git add *": "ask",
      "npm install *": "ask",
      "npm uninstall *": "ask",
      "npm update *": "ask",
      "npm ci *": "ask",
      "npm link *": "ask",
      "npm publish *": "ask",
      "yarn add *": "ask",
      "yarn remove *": "ask",
      "yarn install *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "pnpm install *": "ask",
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "apt install *": "ask",
      "apt-get install *": "ask",
      "brew install *": "ask",
      "brew uninstall *": "ask",
      "sudo *": "ask",
      "* | sh": "ask",
      "* | bash": "ask",
      "* | zsh": "ask",
      "* >> *": "ask",
      "* > *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "truncate *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "systemctl *": "ask",
      "crontab *": "ask",
      "wget * -O *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask"
    }
  }
}
